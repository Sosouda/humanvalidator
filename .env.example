BOT_TOKEN=your_bot_token_here
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
ADMIN_USER=admin
ADMIN_PASS=admin123
TIMEZONE=Europe/Moscow
# Vision : нейронка + OCR даты с фото — раздельные API
VISION_ENABLED=true
VISION_STRICT=false
VISION_MODEL_PATH=
# API нейросети детекции человека (отдельно) — пример Roboflow
VISION_PERSON_API_URL=https://detect.roboflow.com/person-detection-model/1
VISION_PERSON_API_KEY=your_roboflow_api_key
VISION_PERSON_MODEL=yolov8n-person
# API нейросети для даты/времени с фото (отдельно) — пример Yandex Vision OCR
VISION_DATETIME_API_URL=https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText
VISION_DATETIME_API_KEY=your_yandex_api_key
VISION_DATETIME_MODEL=page
# Алерты и health-check
ADMIN_CHAT_ID=0
RECHECK_DELAY_SECONDS=3600
RECHECK_FUZZY_THRESHOLD=0.88
HEALTH_CHECK_INTERVAL=60
HEALTH_CRITICAL_SHIFT_SECONDS=300
HEALTH_CRITICAL_IDLE_SECONDS=1200
HEALTH_FAIL_THRESHOLD=3
